<%= render "admin/nav" %>

<div class="container">
  <div class="page-header">
    <h1><%= @user.username %></h1>
  </div>

  <div class="card">
    <h3>User Details</h3>
    <dl class="detail-list">
      <dt>Username</dt>
      <dd><%= @user.username %></dd>
      <dt>Email</dt>
      <dd><%= @user.email || "-" %></dd>
      <dt>Admin</dt>
      <dd><%= @user.admin? ? "Yes" : "No" %></dd>
      <dt>Joined</dt>
      <dd><%= @user.created_at.strftime("%b %d, %Y at %H:%M") %></dd>
      <dt>Addressbooks</dt>
      <dd><%= @addressbook_count %></dd>
      <dt>Contacts</dt>
      <dd><%= @contact_count %></dd>
    </dl>
  </div>

  <div class="card" style="margin-top: 1.5rem;">
    <h3>Callscreen API token</h3>
    <p class="muted">
      A per-tenant token scopes callscreen access to <strong><%= @user.username %></strong> only
      (it cannot address other tenants). Use it in place of the shared global token.
    </p>
    <dl class="detail-list">
      <dt>Status</dt>
      <dd><%= @user.api_token? ? "Active" : "Not issued" %></dd>
    </dl>
    <div class="admin-actions">
      <%= button_to (@user.api_token? ? "Rotate token" : "Issue token"),
                    regenerate_api_token_admin_user_path(@user), method: :post, class: "btn",
                    form: { data: { turbo_confirm: @user.api_token? ? "Rotating invalidates the current token. Continue?" : nil } } %>
      <% if @user.api_token? %>
        <%= button_to "Revoke token", revoke_api_token_admin_user_path(@user), method: :delete, class: "btn btn-danger",
                      form: { data: { turbo_confirm: "Revoke the API token for #{@user.username}?" } } %>
      <% end %>
    </div>
  </div>

  <div class="admin-actions" style="margin-top: 1.5rem;">
    <%= link_to "Edit User", edit_admin_user_path(@user), class: "btn" %>
    <%= button_to "Delete User", admin_user_path(@user), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Are you sure you want to delete #{@user.username}? This cannot be undone." } } %>
    <%= link_to "Back to Users", admin_users_path, class: "btn" %>
  </div>
</div>
