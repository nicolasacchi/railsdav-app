<div class="container">
<div class="page-header">
  <h1>
    <%= @addressbook.displayname %>
    <% if @addressbook.encryption_enabled? %><span class="status-badge" title="Contains end-to-end encrypted contacts">🔒 Encrypted</span><% end %>
  </h1>
  <div class="actions">
    <%= link_to "New Contact", new_addressbook_contact_path(@addressbook.uri), class: "btn btn-primary" %>
    <%= link_to "Export vCard", export_addressbook_path(@addressbook.uri, export_format: "vcf"), class: "btn" %>
    <%= link_to "Export CSV", export_addressbook_path(@addressbook.uri, export_format: "csv"), class: "btn" %>
    <%= link_to "Export JSON", export_addressbook_path(@addressbook.uri, export_format: "json"), class: "btn" %>
    <%= link_to "Edit", edit_addressbook_path(@addressbook.uri), class: "btn" %>
    <%= link_to "Back", all_contacts_path, class: "btn" %>
  </div>
</div>

<% dav_url = "#{Railsdav.site_url}/dav/#{current_user.username}/contacts/#{@addressbook.uri}/" %>
<div class="dav-url" style="margin-bottom: 1rem;">
  <span>DAV: <%= dav_url %></span>
  <button class="copy-btn" data-copy="<%= dav_url %>" title="Copy DAV URL">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
  </button>
</div>
<div class="dav-url" style="margin-bottom: 1rem;">
  <% if flash[:dav_password] %>
    <span>Password: <code><%= flash[:dav_password] %></code></span>
    <button class="copy-btn" data-copy="<%= flash[:dav_password] %>" title="Copy DAV password">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
  <% else %>
    <span>Password: <code>••••••••••••</code></span>
  <% end %>
  <%= button_to "Regenerate", regenerate_dav_password_addressbook_path(@addressbook.uri), method: :post, class: "btn btn-sm", form: { style: "display: inline;" }, data: { confirm: "Regenerate DAV password? Any CardDAV client using this password will need to be updated." } %>
</div>
<p class="text-muted" style="margin-top: -0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">Use this password in your CardDAV client instead of your account password.</p>

<div class="card">
  <% if @parsed_contacts.empty? %>
    <p>No contacts yet.</p>
  <% else %>
    <ul class="contact-list">
      <% @parsed_contacts.each do |item| %>
        <li class="contact-item">
          <div>
            <div class="contact-name">
              <%= link_to(item[:display]&.full_name || item[:contact].uri,
                          addressbook_contact_path(@addressbook.uri, item[:contact].uri)) %>
            </div>
            <% if item[:display]&.emails&.any? %>
              <div class="contact-meta">
                <%= item[:display].emails.first[:value] %>
                <button class="copy-btn" data-copy="<%= item[:display].emails.first[:value] %>" title="Copy email">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
                <a href="mailto:<%= item[:display].emails.first[:value] %>" class="action-link" title="Send email">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </a>
              </div>
            <% end %>
          </div>
          <% if item[:display]&.phones&.any? %>
            <span class="contact-meta">
              <%= item[:display].phones.first[:value] %>
              <button class="copy-btn" data-copy="<%= item[:display].phones.first[:value] %>" title="Copy phone">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <a href="tel:<%= item[:display].phones.first[:value] %>" class="action-link" title="Call">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </a>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if @pagy.pages > 1 %>
      <div class="pagination">
        <% if @pagy.previous %>
          <a href="<%= addressbook_path(@addressbook.uri, page: @pagy.previous) %>" class="btn btn-sm">&laquo; Prev</a>
        <% else %>
          <span class="btn btn-sm disabled">&laquo; Prev</span>
        <% end %>
        <span class="pagination-info">Page <%= @pagy.page %> of <%= @pagy.pages %></span>
        <% if @pagy.next %>
          <a href="<%= addressbook_path(@addressbook.uri, page: @pagy.next) %>" class="btn btn-sm">Next &raquo;</a>
        <% else %>
          <span class="btn btn-sm disabled">Next &raquo;</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="card">
  <h3>Groups</h3>
  <% groups = @addressbook.contact_groups.ordered %>
  <% if groups.any? %>
    <div class="group-list">
      <% groups.each do |group| %>
        <div class="group-row">
          <%= form_tag addressbook_group_path(@addressbook.uri, group), method: :patch, local: true, class: "group-rename-form" do %>
            <input type="text" name="name" value="<%= group.name %>" class="search-input" style="flex: 1;">
            <button type="submit" class="btn btn-sm">Rename</button>
          <% end %>
          <span class="contact-meta">(<%= group.contacts.individuals.count %>)</span>
          <%= button_to addressbook_group_path(@addressbook.uri, group), method: :delete,
              class: "btn btn-sm btn-danger", form: { style: "display: inline;" },
              data: { confirm: "Delete group \"#{group.name}\"? Contacts will NOT be deleted." } do %>Delete<% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No groups yet.</p>
  <% end %>

  <%= form_tag addressbook_groups_path(@addressbook.uri), method: :post, local: true, class: "share-form", style: "margin-top: 0.75rem;" do %>
    <input type="text" name="name" placeholder="New group name" class="search-input" required>
    <button type="submit" class="btn btn-sm btn-primary">Create Group</button>
  <% end %>
</div>

<div class="card">
  <h3>Import Contacts</h3>
  <%= form_tag import_addressbook_path(@addressbook.uri), method: :post, multipart: true, class: "import-form", data: { turbo: false } do %>
    <div class="form-group">
      <label for="file">Choose file (.vcf, .csv, or .json)</label>
      <%= file_field_tag :file, accept: ".vcf,.csv,.json" %>
    </div>
    <p class="text-muted">Contacts with matching UIDs will be overwritten.</p>
    <button type="submit" class="btn btn-primary">Import</button>
  <% end %>
</div>

<div class="card sharing-section">
  <h3>Sharing</h3>

  <% invitation_shares = @addressbook.shares.where.not(user_id: nil).or(@addressbook.shares.where.not(invited_email: nil)).where(token: nil).includes(:user).order(:created_at) %>
  <% if invitation_shares.any? %>
    <div class="share-list">
      <% invitation_shares.each do |share| %>
        <div class="share-row">
          <% if share.accepted? %>
            <span class="share-username"><%= share.user.username %></span>
          <% else %>
            <span class="share-username"><%= share.invited_email %></span>
            <span class="status-badge">pending</span>
          <% end %>
          <span class="status-badge <%= share.writable? ? 'status-active' : '' %>"><%= share.permission %></span>
          <%= button_to "Remove", addressbook_share_path(@addressbook.uri, share), method: :delete, class: "btn btn-sm btn-danger", form: { style: "display: inline;" } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form_tag addressbook_shares_path(@addressbook.uri), method: :post, local: true, class: "share-form" do %>
    <input type="email" name="email" placeholder="Email address" class="search-input" required>
    <select name="permission" class="search-input">
      <option value="read">Read only</option>
      <option value="write">Read &amp; Write</option>
    </select>
    <button type="submit" class="btn btn-sm btn-primary">Share</button>
  <% end %>

  <div class="public-link-section">
    <h4>Public Link</h4>
    <% public_link = @addressbook.shares.public_links.first %>
    <% if public_link %>
      <div class="public-link-box">
        <input type="text" value="<%= public_share_url(public_link.token) %>" readonly class="search-input" style="flex: 1;" data-select-on-click>
        <%= button_to "Revoke", destroy_public_link_addressbook_path(@addressbook.uri), method: :delete, class: "btn btn-sm btn-danger", form: { style: "display: inline;" } %>
      </div>
      <p class="share-hint">DAV: <%= Railsdav.site_url %>/dav/public/<%= public_link.token %>/</p>
    <% else %>
      <%= button_to "Generate Public Link", create_public_link_addressbook_path(@addressbook.uri), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
</div>
</div>
