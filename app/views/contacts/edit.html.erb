<div class="container">
<turbo-frame id="contact-detail">
<div class="detail-header">
  <h2>Edit: <%= @display&.full_name || @contact.uri %></h2>
</div>

<%= form_with url: addressbook_contact_path(@addressbook.uri, @contact.uri), method: :patch, local: true do |f| %>
  <div class="form-group">
    <%= f.label :first_name, "First Name" %>
    <%= f.text_field :first_name, value: @display&.first_name %>
  </div>
  <div class="form-group">
    <%= f.label :last_name, "Last Name" %>
    <%= f.text_field :last_name, value: @display&.last_name %>
  </div>
  <div class="form-group">
    <%= f.label "emails[]", "Email" %>
    <% (@display&.emails || []).each do |e| %>
      <%= f.text_field "emails[]", value: e[:value] %>
    <% end %>
    <% if @display&.emails&.empty? %>
      <%= f.text_field "emails[]" %>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label "phones[]", "Phone" %>
    <% (@display&.phones || []).each do |p| %>
      <%= f.text_field "phones[]", value: p[:value] %>
    <% end %>
    <% if @display&.phones&.empty? %>
      <%= f.text_field "phones[]" %>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :organization %>
    <%= f.text_field :organization, value: @display&.organization %>
  </div>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, value: @display&.title %>
  </div>
  <div class="form-group">
    <%= f.label :note, "Notes" %>
    <%= f.text_area :note, rows: 3, value: @display&.note %>
  </div>

  <% if @groups.any? %>
    <div class="form-group">
      <label>Groups</label>
      <div class="group-checkboxes">
        <% @groups.each do |group| %>
          <label class="checkbox-label">
            <%= check_box_tag "group_ids[]", group.id, @contact.contact_group_ids.include?(group.id) %>
            <%= group.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <details style="margin-top: 1rem; margin-bottom: 1rem;">
    <summary>Edit raw vCard instead</summary>
    <div class="form-group" style="margin-top: 0.5rem;">
      <%= f.label :raw_vcard, "Raw vCard" %>
      <%= f.text_area :raw_vcard, value: @contact.vcard_data %>
    </div>
  </details>

  <div class="actions">
    <%= f.submit "Update Contact", class: "btn btn-primary" %>
    <%= link_to "Cancel", addressbook_contact_path(@addressbook.uri, @contact.uri), class: "btn", data: { panel_link: true } %>
  </div>
<% end %>
</turbo-frame>
</div>
