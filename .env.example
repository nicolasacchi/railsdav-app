SECRET_KEY_BASE=generate-with-bin-rails-secret
APP_HOST=localhost
SITE_NAME=Contacts
SITE_URL=https://contacts.example.com
ALLOW_REGISTRATION=false
MAILER_FROM=noreply@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=  # REQUIRED: set a strong password (min 8 chars)

# Optional: internal JSON API + contact-change webhook for a trusted call-screen
# service on the same private network. Leave unset unless you run that stack.
# CALLSCREEN_API_TOKEN=
# CALLSCREEN_API_USERNAME=
# CALLSCREEN_WEBHOOK_URL=https://callscreen.example.com/webhook
# CALLSCREEN_WEBHOOK_TOKEN=

# Optional: SQLite snapshot backups (VACUUM INTO). Defaults shown.
# DB_BACKUP_DIR=storage/backups
# DB_BACKUP_KEEP=7

# Optional: ISO 3166-1 alpha-2 used to parse local phone numbers. Default IT.
# PHONE_DEFAULT_COUNTRY=IT

# SOLID_QUEUE_IN_PUMA is set by docker-compose.yml for the single-container
# production-like image. Do not set it here.
