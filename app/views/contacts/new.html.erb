<div class="container">
<turbo-frame id="contact-detail">
<div class="detail-header">
  <h2>New Contact</h2>
  <p class="contact-meta">in <%= @addressbook.displayname %></p>
</div>

<%= form_with url: addressbook_contacts_path(@addressbook.uri), method: :post, local: true do |f| %>
  <div class="form-group">
    <%= f.label :first_name, "First Name" %>
    <%= f.text_field :first_name %>
  </div>
  <div class="form-group">
    <%= f.label :last_name, "Last Name" %>
    <%= f.text_field :last_name %>
  </div>

  <details>
    <summary>Name details</summary>
    <div class="form-group">
      <%= f.label :name_prefix, "Prefix (Dr., Mr.)" %>
      <%= f.text_field :name_prefix %>
    </div>
    <div class="form-group">
      <%= f.label :middle_name, "Middle Name" %>
      <%= f.text_field :middle_name %>
    </div>
    <div class="form-group">
      <%= f.label :name_suffix, "Suffix (Jr., III)" %>
      <%= f.text_field :name_suffix %>
    </div>
  </details>

  <div class="form-group">
    <%= f.label :nickname %>
    <%= f.text_field :nickname %>
  </div>
  <div class="form-group">
    <%= f.label :pronouns, "Pronouns" %>
    <%= f.text_field :pronouns, placeholder: "e.g. they/them" %>
  </div>

  <div class="form-group">
    <%= f.label "emails[]", "Email" %>
    <%= f.text_field "emails[]" %>
  </div>
  <div class="form-group">
    <%= f.label "phones[]", "Phone" %>
    <%= f.text_field "phones[]" %>
  </div>
  <div class="form-group">
    <%= f.label :organization %>
    <%= f.text_field :organization %>
  </div>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <div class="form-group">
    <%= f.label :role, "Role" %>
    <%= f.text_field :role %>
  </div>
  <div class="form-group">
    <%= f.label :note, "Notes" %>
    <%= f.text_area :note, rows: 3 %>
  </div>

  <div class="form-group">
    <%= f.label :birthday, "Birthday" %>
    <%= f.date_field :birthday %>
  </div>
  <div class="form-group">
    <%= f.label :anniversary, "Anniversary" %>
    <%= f.date_field :anniversary %>
  </div>

  <div class="form-group">
    <%= f.label "urls[]", "Website" %>
    <%= f.text_field "urls[]", placeholder: "https://..." %>
  </div>

  <details>
    <summary>Addresses</summary>
    <fieldset style="border: 1px solid var(--border); padding: 0.75rem; margin-bottom: 0.5rem; border-radius: 6px;">
      <div class="form-group">
        <label>Type</label>
        <select name="addresses[][type]">
          <option value="HOME">Home</option>
          <option value="WORK">Work</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
      <div class="form-group"><label>Street</label><input type="text" name="addresses[][street]"></div>
      <div class="form-group"><label>City</label><input type="text" name="addresses[][city]"></div>
      <div class="form-group"><label>State</label><input type="text" name="addresses[][state]"></div>
      <div class="form-group"><label>ZIP</label><input type="text" name="addresses[][zip]"></div>
      <div class="form-group"><label>Country</label><input type="text" name="addresses[][country]"></div>
    </fieldset>
  </details>

  <details>
    <summary>Social & Messaging</summary>
    <div class="form-group">
      <label>Instant Messaging</label>
      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.25rem;">
        <input type="text" name="impp[][type]" placeholder="Type" style="width: 30%;">
        <input type="text" name="impp[][value]" placeholder="Handle or URI" style="width: 70%;">
      </div>
    </div>
    <div class="form-group">
      <label>Social Profiles</label>
      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.25rem;">
        <input type="text" name="social_profiles[][type]" placeholder="Service" style="width: 30%;">
        <input type="text" name="social_profiles[][value]" placeholder="URL or handle" style="width: 70%;">
      </div>
    </div>
    <div class="form-group">
      <%= f.label :gender, "Gender" %>
      <%= f.text_field :gender %>
    </div>
  </details>

  <% if @addressbook.user_id == current_user.id %>
    <div class="form-group">
      <%= label_tag :call_screening_policy, "Call screening" %>
      <%= select_tag :call_screening_policy, options_for_select([
            ["Inherit from addressbook (#{@addressbook.call_screening_policy})", "inherit"],
            ["Default screening", "screen"],
            ["Auto-allow (skip spam check)", "allow"],
            ["Auto-block (reject as spam)", "block"]
          ], "inherit") %>
    </div>
  <% end %>

  <% if @groups.any? %>
    <div class="form-group">
      <label>Groups</label>
      <div class="group-checkboxes">
        <% @groups.each do |group| %>
          <label class="checkbox-label">
            <%= check_box_tag "group_ids[]", group.id, false %>
            <%= group.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <details style="margin-top: 1rem; margin-bottom: 1rem;">
    <summary>Paste raw vCard instead</summary>
    <div class="form-group" style="margin-top: 0.5rem;">
      <%= f.label :raw_vcard, "Raw vCard" %>
      <%= f.text_area :raw_vcard, placeholder: "BEGIN:VCARD\nVERSION:3.0\n..." %>
    </div>
  </details>

  <div class="actions">
    <%= f.submit "Create Contact", class: "btn btn-primary" %>
    <%= link_to "Cancel", all_contacts_path, class: "btn" %>
  </div>
<% end %>
</turbo-frame>
</div>
