<div class="auth-form">
  <h1>Set Your Email</h1>
  <p class="auth-subtitle">An email address is now required for your account.</p>

  <%= form_with model: @user, url: profile_path, method: :patch, class: "form" do |f| %>
    <% if @user.errors.any? %>
      <div class="flash flash-alert">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
    </div>

    <%= f.submit "Save", class: "btn btn-primary btn-block" %>
  <% end %>

  <hr style="margin: 2rem 0;">

  <h2 style="color: var(--danger);">Delete Account</h2>
  <p class="auth-subtitle">This will permanently delete your account and all your data, including address books, contacts, and shares. This action cannot be undone.</p>

  <%= form_with url: profile_path, method: :delete, class: "form", data: { turbo: false } do |f| %>
    <div class="form-group">
      <%= f.label :password, "Confirm your password" %>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password to confirm" %>
    </div>
    <%= f.submit "Delete My Account", class: "btn btn-danger btn-block", data: { confirm: "Are you absolutely sure? This cannot be undone." } %>
  <% end %>
</div>
