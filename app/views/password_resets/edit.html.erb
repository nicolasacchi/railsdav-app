<div class="auth-form">
  <h1>Reset Password</h1>
  <p class="auth-subtitle">Choose a new password.</p>

  <%= form_with url: reset_password_path(token: params[:token]), method: :patch, local: true, class: "form" do |f| %>
    <% if @user.errors.any? %>
      <div class="flash flash-alert">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :password, "New Password" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
    </div>
    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm New Password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
    <%= f.submit "Reset Password", class: "btn btn-primary btn-block" %>
  <% end %>

  <p class="auth-footer"><%= link_to "Back to login", login_path %></p>
</div>
