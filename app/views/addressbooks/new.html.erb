<div class="container">
<div class="page-header">
  <h1>New Address Book</h1>
</div>

<div class="card">
  <%= form_with model: @addressbook, url: addressbooks_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :uri, "URI (used in DAV URL)" %>
      <%= f.text_field :uri %>
    </div>
    <div class="form-group">
      <%= f.label :displayname, "Display Name" %>
      <%= f.text_field :displayname %>
    </div>
    <div class="form-group">
      <%= f.label :description %>
      <%= f.text_field :description %>
    </div>
    <div class="actions">
      <%= f.submit "Create", class: "btn btn-primary" %>
      <%= link_to "Cancel", addressbooks_path, class: "btn" %>
    </div>
  <% end %>
</div>
</div>
