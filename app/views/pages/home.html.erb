<section class="hero">
  <div class="container">
    <h1 class="hero-title">Your Contacts.<br>Your Server.</h1>
    <p class="hero-subtitle">A private, self-hosted CardDAV server that syncs with your phone. No big tech, no data mining, no compromise.</p>
    <div class="hero-actions">
      <%= link_to "Get Started", register_path, class: "btn btn-hero btn-primary" %>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <h2 class="section-title">Why Contacts?</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3>Privacy First</h3>
        <p>Your contacts live on your server. Not Google's, not Apple's &mdash; yours. End-to-end under your control.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Unlimited Contacts</h3>
        <p>Store as many contacts as you need. No artificial limits, no per-contact pricing, no upsells.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </div>
        <h3>Seamless Sync</h3>
        <p>Works with iPhone, Mac, Android, and GrapheneOS. No extra app needed on Apple devices. Changes sync automatically in the background.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <h3>Web Interface</h3>
        <p>Manage your contacts from any browser. Create, edit, and search &mdash; no app installation required.</p>
      </div>
    </div>
  </div>
</section>

<section class="open-source-section">
  <div class="container">
    <h2 class="section-title">Open Source</h2>
    <p class="oss-text">The entire server is <a href="https://github.com/nicolasacchi/railsdav" target="_blank" rel="noopener">open source</a> and free to self-host. You can run your own instance on your own hardware &mdash; no strings attached.</p>
    <a href="https://github.com/nicolasacchi/railsdav" target="_blank" rel="noopener" class="oss-link">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      View on GitHub
    </a>
  </div>
</section>
